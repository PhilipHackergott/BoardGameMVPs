{
  "name": "cull-the-crown",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cull the Crown MVP — a Regicide x Balatro single-player roguelike. Original working title; clean mechanics-only reimplementation.",
  "scripts": {
    "dev": "vite",
    "gen:tokens": "node scripts/gen-tokens.mjs",
    "build": "node scripts/gen-tokens.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "pixi.js": "^8.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
