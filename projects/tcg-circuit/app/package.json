{
  "name": "tcg-circuit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "TCG Circuit MVP — PRISM, an original trading card game. Card-game-first slice (engine + duel + deckbuilder + AI ladder + balance sim); the JRPG career world is designed + deferred.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run tests/engine",
    "test:e2e": "playwright test",
    "lint": "tsc --noEmit",
    "sim": "vitest run tests/sim"
  },
  "dependencies": {
    "pixi.js": "^8.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^20.19.41",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
